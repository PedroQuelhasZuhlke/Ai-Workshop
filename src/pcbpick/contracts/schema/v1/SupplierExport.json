{
  "$defs": {
    "ExportFormat": {
      "enum": [
        "csv",
        "xlsx"
      ],
      "title": "ExportFormat",
      "type": "string"
    },
    "SupplierId": {
      "enum": [
        "mouser",
        "digikey",
        "farnell",
        "fixture"
      ],
      "title": "SupplierId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A supplier-ready import file, tied to the exact approved plan it was generated from.",
  "properties": {
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approved_by": {
      "title": "Approved By",
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/ExportFormat"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "supplier": {
      "$ref": "#/$defs/SupplierId"
    }
  },
  "required": [
    "supplier",
    "format",
    "rows",
    "approved_by",
    "approved_at",
    "plan_hash"
  ],
  "title": "SupplierExport",
  "type": "object"
}
